# Keep the image small and free of local junk. Secrets never go into the image: .env stays on the VM
# and docker-compose.yml mounts it read-only at /app/.env, where the bot reads it.
.env
.env.*
!.env.example
.git
.idea
.claude
**/__pycache__
*.pyc
data/
download
*.rar
*.log

# VM-only files: database compose project, its passwords and key file
deploy/
