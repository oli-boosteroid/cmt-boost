#SLACK
SLACK_TOKEN=SLACK_TOKEN
SLACK_SIGNING_SECRET=SLACK_SIGNING_SECRET
SLACK_REPORT_API_URL=SLACK_REPORT_API_URL
# User proposals only (Feature / Payment Method / ...). Games go to our own wishlist (services/wishlist_store.py).
SLACK_PROPOSAL_API_URL=SLACK_PROPOSAL_API_URL
# Wishlist: Monday summary of the previous week to SLACK_WISHLIST_NOTIFICATIONS_CHANNEL_ID at this hour (Kyiv)
#WISHLIST_SUMMARY_HOUR=9
SLACK_MODMAIL_CHANNEL=SLACK_MODMAIL_CHANNEL
SLACK_REDDIT_COMMENTS_CHANNEL=SLACK_REDDIT_COMMENTS_CHANNEL
SLACK_DISCORD_CHANNEL_ID=SLACK_DISCORD_CHANNEL_ID
SLACK_DISCORD_MODMAIL_CHANNEL_ID=SLACK_DISCORD_MODMAIL_CHANNEL_ID
SLACK_TESTING_SESSIONS_CHANNEL_ID=SLACK_TESTING_SESSIONS_CHANNEL_ID
SLACK_MAINTENANCE_NOTIFCATIONS_CHANNEL_ID=SLACK_MAINTENANCE_NOTIFCATIONS_CHANNEL_ID
SLACK_COMMON_ACTIONS_CHANNEL_ID=SLACK_COMMON_ACTIONS_CHANNEL_ID
SLACK_COMMUNITY_REPORTS_CHANNEL_ID=SLACK_COMMUNITY_REPORTS_CHANNEL_ID
SLACK_REPORTS_CHANNEL_ID=SLACK_REPORTS_CHANNEL_ID
SLACK_SERVERS_MAINTENANCE_CHANNEL_ID=SLACK_SERVERS_MAINTENANCE_CHANNEL_ID
SLACK_GAMES_MAINTENANCE_CHANNEL_ID=SLACK_GAMES_MAINTENANCE_CHANNEL_ID
SLACK_USERS_EMAILS_CHANNEL_ID=SLACK_USERS_EMAILS_CHANNEL_ID
SLACK_FLOOD_CHANNEL_ID=SLACK_FLOOD_CHANNEL_ID

#REDDIT

REDDIT_CLIENT_ID=REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=REDDIT_CLIENT_SECRET
REDDIT_USER_AGENT=REDDIT_USER_AGENT
IGNORED_USERS=IGNORED_USER,IGNORED_USER,IGNORED_USERS,IGNORED_USERS
SUBREDDIT_NAME=SUBREDDIT_NAME
REDDIT_USERNAME=REDDIT_USERNAME
REDDIT_PASSWORD=REDDIT_PASSWORD

#MONGODB
# On the VM Mongo runs in Docker (container "mongodb"): host in MONGODB_URI = mongodb, and join its network:
#COMPOSE_FILE=docker-compose.yml:docker-compose.mongo.yml
#MONGO_NETWORK=<network of the mongodb container>

MONGODB_URI=MONGODB_URI
MONGODB_DATABASE=MONGODB_DATABASE

#DISCORD

DISCORD_TOKEN=DISCORD_TOKEN
MODERATORS=MODERATOR,MODERATORS,MODERATORS,MODERATORS,MODERATORS
DISCORD_FORUMS_ID=DISCORD_FORUM_ID,DISCORD_FORUM_ID
DISCORD_WELCOME_MESSAGE=MESSAGE_WHEN_USER_CONNECTED
DISCORD_GUILD_ID=DISCORD_SERVER_ID
DISCORD_MOD_ROLE_ID=MOD_ROLE_ID
DISCORD_MODMAIL_CATEGORY_ID=CATEGORY_ID
DISCORD_CLOSED_MODMAIL_CATEGORY_ID=DISCORD_CLOSED_MODMAIL_CATEGORY_ID

#JIRA

JIRA_BASE_URL=https://yourcompany.atlassian.net
# Channel where Jira's native Slack integration posts (source, read-only)
SLACK_JIRA_NOTIFICATIONS_CHANNEL_ID=C0XXXXXXXX
# Channel where our bot sends processed Jira alerts
SLACK_JIRA_CHANNEL_ID=C0XXXXXXXX

# The CMT Console is a separate service (cmt-console repo, its own env); the bot needs none of its keys.

#CLOUD OPERATIONS API (read-only: User ID lookup + recent sessions)

# API key issued for the bot. Only this VM holds it; the console reaches the API through the queue.
CLOUD_API_KEY=
# Production by default. Use https://stage.boosteroid.com to test.
CLOUD_API_BASE_URL=https://cloud.boosteroid.com
# The API rejects requests without a User-Agent.
CLOUD_API_USER_AGENT=cmt-bot/1.0
# Only if the key uses a domain whitelist.
CLOUD_API_CLIENT_DOMAIN=
# Hard local ceiling on requests to the cloud API (the API itself allows 60 per minute).
CLOUD_API_MAX_PER_MINUTE=50
CLOUD_API_MAX_PER_HOUR=3000

#CONSOLE ON THE VM
# Internal Jira gateway for the console (services/jira_gateway.py). Empty = off. Same value in the console's
# deploy/console.env. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JIRA_GATEWAY_TOKEN=
JIRA_GATEWAY_PORT=7001

#MAINTENANCES
# Game / server maintenances follow the Mattermost admin events (services/mm_maintenance.py). 0 = off.
MM_MAINTENANCE=1
